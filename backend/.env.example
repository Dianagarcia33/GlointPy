ENVIRONMENT=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=glointpruebas_db
SQL_ECHO=false

# ==========================================
# YOINT PAYMENTS API (Dispersiones de Retiros)
# ==========================================
YOINT_API_URL=https://dev-transaccional-payments.yoint.co
YOINT_API_KEY=
YOINT_CLIENT_ID=
YOINT_CLIENT_SECRET=
YOINT_WEBHOOK_SECRET=

# ==========================================
# TUSDATOS.CO (Verificación SARLAFT / Listas Restrictivas)
# Por defecto apunta al Sandbox / Ambiente de pruebas oficial
# Para producción: TUSDATOS_BASE_URL=https://api.tusdatos.co
# ==========================================
TUSDATOS_BASE_URL=https://docs.tusdatos.co
TUSDATOS_USERNAME=pruebas
TUSDATOS_PASSWORD=password


# ==========================================
# CORS y cookie de sesion (H-33)
# Origenes (CSV) que pueden leer respuestas con la cookie de sesion. Web y API comparten dominio en
# staging/produccion, asi que alli basta con los dominios propios; FRONTEND_URL se agrega solo.
# Produccion: CORS_ALLOWED_ORIGINS=https://gloint.com.co,https://www.gloint.com.co
# Staging:    CORS_ALLOWED_ORIGINS=https://pruebas.gloint.com.co
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# lax (recomendado). "none" solo como reversa de emergencia
COOKIE_SAMESITE=lax
