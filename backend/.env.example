# Para producción: TUSDATOS_BASE_URL=https://api.tusdatos.co
# ==========================================
TUSDATOS_BASE_URL=https://docs.tusdatos.co
TUSDATOS_USERNAME=pruebas
TUSDATOS_PASSWORD=password

